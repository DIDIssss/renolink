# Exemplo documental. O servidor não lê .env automaticamente.
# Local: usa cópia operacional JSON em data/runtime/db.json e escuta apenas 127.0.0.1.
STORAGE_DRIVER=json
PORT=3000
COOKIE_SECURE=0
# PostgreSQL: definir STORAGE_DRIVER=postgres e DATABASE_URL fornecida pelo operador.
# Não há URL ou credencial padrão. Usar TLS conforme o provedor, sem desabilitar validação.
# Produção também exige APP_ORIGIN com origem HTTPS exata e COOKIE_SECURE=1.
# Não definir RENOLINK_MIGRATION_APPROVED sem autorização explícita da migração.

# MySQL é o destino principal. Manter json até configurar e importar com autorização.
# Para habilitar: STORAGE_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Definir MYSQL_DATABASE, MYSQL_USER e MYSQL_PASSWORD com valores reais, fora do repositório.
MYSQL_SSL=0
# Em hospedagem: MYSQL_SSL=1; MYSQL_SSL_CA opcional aponta para certificado CA confiável.
# NODE_ENV=production exige MySQL, TLS no banco, APP_ORIGIN HTTPS e COOKIE_SECURE=1.
# Importação autorizada: RENOLINK_MYSQL_MIGRATION_APPROVED=1 apenas no terminal do migrador.
# Teste real: TEST_MYSQL_HOST, TEST_MYSQL_PORT, TEST_MYSQL_DATABASE,
# TEST_MYSQL_USER, TEST_MYSQL_PASSWORD, TEST_MYSQL_SSL e TEST_MYSQL_SSL_CA.
# TEST_MYSQL_DATABASE deve ser renolink_test ou renolink_test_<sufixo>, dedicado e vazio.
# RENOLINK_TEST_MYSQL_APPROVED=1 habilita teste real; nunca usa MYSQL_DATABASE implicitamente.
