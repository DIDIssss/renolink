# Configure in Render's Environment panel. Node does not load this file itself.
NODE_ENV=production
NODE_VERSION=24.22.1
APP_ENV=render
STORAGE_DRIVER=mysql
COOKIE_SECURE=1
MYSQL_SSL=1
TRUST_PROXY=render
APP_LOG_FORMAT=json
MYSQL_PROVIDER=enzonic
MYSQL_HOST=renolink-prod-m84hr0.db.enzonic.com
MYSQL_PORT=3306
MYSQL_DATABASE=main
# Operator values:
# APP_ORIGIN: exact https://<service>.onrender.com origin, no trailing slash
# MYSQL_USER, MYSQL_PASSWORD: secret runtime values from the provider
# MYSQL_SSL_CA: optional /etc/secrets/mysql-ca.pem when provider requires custom CA
# RENDER, RENDER_SERVICE_ID, RENDER_EXTERNAL_HOSTNAME, PORT: supplied by Render
# No TEST_MYSQL_*, migration approvals, local paths or APP_ENV=fair.
