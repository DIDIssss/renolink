# TEMPLATE INERTE. So instalar no servidor externo depois de autorizacao.
# Acesso somente via VPN/allowlist: substituir IPs ficticios; manter deny all.
server {
    listen 443 ssl;
    server_name staging.renolink.invalid;
    ssl_certificate /etc/renolink/tls/fullchain.pem;
    ssl_certificate_key /etc/renolink/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow 127.0.0.1;
    deny all;
    server_tokens off;
    client_max_body_size 64k;
    client_body_timeout 10s;
    # Sem access_log: caminhos/query podem conter informacao sensivel.
    access_log off;
    error_log /var/log/nginx/renolink-staging-error.log crit;
    # Sem 'root'/'alias': somente a allowlist estatica da aplicacao.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_next_upstream off;
    }
    location = /api/events {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_next_upstream off;
    }
}
