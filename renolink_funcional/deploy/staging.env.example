# Modelo SEM segredos. Nao e carregado automaticamente. Arquivo real fora do repositorio.
NODE_ENV=production
APP_ENV=staging
STORAGE_DRIVER=mysql
PORT=3000
APP_ORIGIN=https://staging.renolink.invalid
COOKIE_SECURE=1
TRUST_PROXY=loopback
APP_LOG_FORMAT=json
UV_THREADPOOL_SIZE=4
RENOLINK_CRYPTO_CONCURRENCY=4
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=renolink_staging
MYSQL_USER=renolink_staging_app
MYSQL_PASSWORD=
MYSQL_SSL=1
MYSQL_SSL_CA=/etc/renolink/secrets/mysql-ca.pem
# Somente apos autorizacao do ambiente externo privado:
RENOLINK_STAGING_START_APPROVED=0
