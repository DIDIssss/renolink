# Modelo documental apenas. Nao copiar como arquivo operacional nem carregar.
# Valores .invalid e campos vazios sao intencionais e devem falhar em producao.
NODE_ENV=production
APP_ENV=fair
RENOLINK_FAIR_SERVICE_ACCOUNT=renolink_fair_svc
RENOLINK_FAIR_DB_ROLE=runtime
STORAGE_DRIVER=mysql
PORT=3100
APP_ORIGIN=https://feira.invalid
COOKIE_SECURE=1
TRUST_PROXY=loopback
APP_LOG_FORMAT=json

# Banco exclusivo futuro; ainda nao existe. Nunca substituir por renolink_dev/test.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=renolink_feira
MYSQL_USER=renolink_feira_app
MYSQL_PASSWORD=
MYSQL_SSL=1
MYSQL_SSL_CA=C:\ProgramData\RenoLink\fair\secrets\mysql-ca.pem
# UUID conhecido somente depois do provisionamento; vazio e intencionalmente recusado.
RENOLINK_FAIR_MYSQL_SERVER_UUID=

# Pastas ilustrativas fora do release; devem ser provisionadas com ACLs restritas.
RENOLINK_FAIR_LOG_DIR=C:\ProgramData\RenoLink\fair\logs
RENOLINK_FAIR_BACKUP_DIR=E:\RenoLinkFair\backups

# Nenhum segredo ou recurso externo e fornecido por este modelo.
